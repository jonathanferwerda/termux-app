<?xml version="1.0" encoding="utf-8"?>
<!-- JawnOS Home. All text is literal English because strings.xml belongs to
     other work in this change; labels here are either replaced at runtime
     (clock/date/dock/usage) or are the small fixed prompts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF101010"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="#FFF7F7F2"
                android:textSize="46sp" />

            <TextView
                android:id="@+id/home_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.04"
                android:textColor="#FF8E8E8E"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/jawn_home_chip"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="Home settings"
            android:textColor="#FFB8B8B8"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/home_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/jawn_home_search"
        android:hint="Search apps or JawnOS"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp"
        android:singleLine="true"
        android:textColor="#FFF0F0F0"
        android:textColorHint="#FF7A7A7A"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/home_role_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/jawn_home_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_role_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="JawnOS is not your Home screen yet."
            android:textColor="#FFDADADA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/home_role_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Set as Home"
            android:textColor="#FFFFCC00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_role_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Not now"
            android:textColor="#FF8E8E8E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The printer card: a real AppWidgetHost slot, so the clockface the
         manager's own JavaScript draws lives on the home screen. It stays
         gone until the host has bound the JawnOS provider. -->
    <FrameLayout
        android:id="@+id/home_widget_slot"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/home_jawnos_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_jawnos_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="JawnOS"
            android:textAllCaps="true"
            android:textColor="#FF8E8E8E"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_jawnos_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Apps the house is running now: the clothesline, refreshed while the
         home is on screen. It draws its own visibility. -->
    <LinearLayout
        android:id="@+id/home_running_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_running_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="Running"
            android:textAllCaps="true"
            android:textColor="#FF8E8E8E"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_running_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- The system apps' shelves. Long-press an app and drop it on a chip to
         move it; the choice is kept on this device. -->
    <HorizontalScrollView
        android:id="@+id/home_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_categories_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/home_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="84dp"
            android:horizontalSpacing="4dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="auto_fit"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/home_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No apps found on this device."
            android:textColor="#FF7A7A7A"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF242424" />

    <LinearLayout
        android:id="@+id/home_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF161616"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>
