<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- URL bar and navigation -->
    <LinearLayout
        android:id="@+id/browser_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/browser_back"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#8592;"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/browser_forward"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#8594;"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <TextView
            android:id="@+id/browser_reload"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#10227;"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Reload" />

        <EditText
            android:id="@+id/browser_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:hint="Enter a web address"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/browser_go"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Go"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open address" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/browser_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:visibility="gone" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/browser_tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <TextView
            android:id="@+id/browser_tab_add"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textSize="22sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="New tab" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/browser_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/browser_measure_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</LinearLayout>
